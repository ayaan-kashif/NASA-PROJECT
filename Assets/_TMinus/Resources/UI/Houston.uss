/* HOUSTON overlay UI style: Navy glass, orange accent, clean typography */

.houston-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.houston-panel {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 380px;
    max-height: 440px;
    background-color: rgba(10, 16, 36, 0.94);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 122, 26, 0.5);
    padding: 12px;
    display: flex;
    flex-direction: column;
}

.houston-panel.hidden {
    display: none;
}

.houston-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.houston-title-row {
    flex-direction: row;
    align-items: center;
}

.houston-title {
    color: rgb(255, 122, 26);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 6px;
}

.houston-close-btn {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.7);
    border-width: 0;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.houston-close-btn:hover {
    color: white;
}

.houston-messages-scroll {
    flex-grow: 1;
    max-height: 240px;
    min-height: 120px;
    margin-bottom: 8px;
}

.houston-msg-item {
    margin-bottom: 6px;
    padding: 6px 8px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

.houston-msg-text {
    color: rgb(235, 240, 250);
    font-size: 13px;
    white-space: normal;
}

.houston-msg-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.houston-rating-btn {
    background-color: transparent;
    border-width: 0;
    font-size: 12px;
    padding: 2px 4px;
    color: rgba(255, 255, 255, 0.5);
}

.houston-rating-btn:hover {
    color: rgb(255, 122, 26);
}

.houston-typing {
    color: rgba(255, 180, 120, 0.8);
    font-size: 12px;
    margin-bottom: 6px;
    -unity-font-style: italic;
}

.houston-buttons-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.houston-btn {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(225, 235, 250);
    font-size: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 122, 26, 0.3);
    padding: 4px 8px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.houston-btn:hover {
    background-color: rgba(255, 122, 26, 0.2);
    border-color: rgb(255, 122, 26);
}

.houston-input-row {
    flex-direction: row;
    align-items: center;
}

.houston-input {
    flex-grow: 1;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.3);
    color: white;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    padding-left: 8px;
    font-size: 12px;
}

.houston-toggle-fab {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(255, 122, 26);
    color: white;
    font-size: 22px;
    border-width: 0;
    -unity-text-align: middle-center;
}

.houston-toggle-fab:hover {
    background-color: rgb(255, 145, 60);
}

.houston-notice {
    font-size: 11px;
    color: rgb(150, 165, 190);
    white-space: normal;
    margin: 4px 10px 8px 10px;
}

/* Urdu answers (audit A-06): an Arabic-script font, right-aligned, with Unity's advanced text generator for letter joining and right-to-left order. */
.houston-urdu {
    -unity-font-definition: url("project://database/Assets/_TMinus/Resources/Fonts/NotoNaskhArabic-Regular.ttf");
    -unity-text-generator: advanced;
    -unity-text-align: upper-right;
    font-size: 16px;
}
