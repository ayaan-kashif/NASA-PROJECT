/* T-MINUS main menu: dark navy, white text, one orange accent (#FF7A1A). */

.menu-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);   /* the live 3D backdrop (MenuBackdrop) shows through */
    justify-content: center;
    padding-left: 110px;
}

.stars {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(4, 8, 22, 0.25);
}

.menu-panel {
    width: 580px;
    flex-direction: column;
    background-color: rgba(6, 10, 26, 0.78);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 4px;
    border-left-color: rgb(255, 122, 26);
    padding: 34px 38px 26px 38px;
}

.title {
    font-size: 92px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    margin-bottom: 4px;
    padding: 0;
}

.tagline {
    font-size: 22px;
    color: rgb(175, 190, 220);
    white-space: normal;
    margin-bottom: 18px;
    padding: 0;
}

.accent-line {
    width: 96px;
    height: 5px;
    background-color: rgb(255, 122, 26);
    border-radius: 3px;
    margin-bottom: 36px;
}

.menu-button {
    height: 64px;
    margin: 0 0 14px 0;
    padding-left: 24px;
    font-size: 26px;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgb(255, 122, 26);
    translate: 6px 0;
}

.menu-button:active {
    background-color: rgba(255, 122, 26, 0.35);
}

.menu-button:focus {
    border-color: rgb(255, 122, 26);
}

.menu-button.primary {
    background-color: rgb(255, 122, 26);
    border-color: rgb(255, 122, 26);
    -unity-font-style: bold;
}

.menu-button.primary:hover {
    background-color: rgb(255, 145, 60);
}

.menu-button.quiet {
    color: rgb(175, 190, 220);
}

.toast {
    position: absolute;
    bottom: 60px;
    left: 140px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 122, 26, 0.9);
    padding: 12px 20px;
    border-radius: 10px;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.toast.hidden {
    opacity: 0;
}

.version {
    position: absolute;
    right: 24px;
    bottom: 18px;
    font-size: 16px;
    color: rgb(110, 125, 160);
}

/* ---- overlays: Codex, Settings, Sandbox ---- */
.overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(4, 8, 20, 0.86);
    align-items: center; justify-content: center;
}
.overlay-card {
    width: 70%; max-width: 1200px; height: 82%;
    background-color: rgb(14, 22, 46);
    border-width: 2px; border-color: rgba(255, 255, 255, 0.14); border-radius: 16px;
    border-top-color: rgb(255, 122, 26); border-top-width: 4px;
    padding: 28px 36px;
}
.overlay-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.overlay-title { font-size: 40px; -unity-font-style: bold; color: rgb(255, 255, 255); letter-spacing: 6px; }
.overlay-close {
    font-size: 20px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2); border-radius: 8px; padding: 6px 16px;
}
.overlay-close:hover { border-color: rgb(255, 122, 26); }
.overlay-body { flex-grow: 1; color: rgb(225, 232, 245); font-size: 20px; }
.overlay-body .muted { color: rgb(150, 165, 195); white-space: normal; margin: 6px 0 12px 0; font-size: 18px; }
.codex-search { font-size: 20px; margin-bottom: 4px; }
.codex-list { flex-grow: 1; }
.codex-item { margin-bottom: 6px; font-size: 22px; color: rgb(255, 255, 255); }
.codex-short { white-space: normal; color: rgb(255, 196, 140); font-size: 19px; margin: 4px 0; }
.codex-long { white-space: normal; color: rgb(205, 214, 232); font-size: 18px; margin-bottom: 6px; }
.codex-source { font-size: 15px; color: rgb(140, 190, 255); background-color: rgba(0, 0, 0, 0); border-width: 0; -unity-text-align: middle-left; padding: 2px 0; }
.settings-row { margin: 10px 0 18px 0; font-size: 22px; color: rgb(255, 255, 255); }
.sandbox-room { height: auto; padding-top: 12px; padding-bottom: 12px; white-space: normal; }

/* ---- Failure Lab ---- */
.job-card { background-color: rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 16px 20px; margin-bottom: 14px; border-left-width: 4px; border-left-color: rgb(255, 122, 26); }
#job-title { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.job-note { white-space: normal; color: rgb(220, 228, 245); font-size: 19px; margin: 6px 0 10px 0; }
.job-card .menu-button { height: 52px; margin: 4px 0 0 0; width: 260px; }
.a12-clock { font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 6px; }
.a12-prompt { white-space: normal; font-size: 20px; color: rgb(255, 196, 140); margin-bottom: 12px; }
.a12-lights { flex-direction: row; flex-wrap: wrap; width: 55%; margin-right: 20px; }
.a12-light { width: 31%; margin: 0 2% 8px 0; padding: 8px 4px; font-size: 16px; -unity-text-align: middle-center; color: rgb(120, 110, 90); background-color: rgb(40, 34, 24); border-radius: 4px; }
.a12-light.a12-on { color: rgb(30, 18, 0); background-color: rgb(255, 190, 60); -unity-font-style: bold; }
.a12-tlm { flex-grow: 1; background-color: rgb(4, 10, 6); border-radius: 6px; padding: 10px 14px; }
.a12-tlm-row { color: rgb(120, 255, 150); font-size: 19px; margin-bottom: 4px; }
.a12-feedback { white-space: normal; font-size: 19px; margin: 12px 0; min-height: 52px; }
.a12-good { color: rgb(150, 255, 170); }
.a12-bad { color: rgb(255, 150, 130); }
.a12-switches { flex-direction: row; flex-wrap: wrap; }
.a12-switch { width: 31%; height: 56px; margin: 0 2% 10px 0; font-size: 19px; color: rgb(255, 255, 255); background-color: rgb(52, 58, 72); border-color: rgb(120, 130, 150); border-width: 2px; border-radius: 8px; }
.a12-switch:hover { border-color: rgb(255, 122, 26); }
.overlay-card.a12-flash { background-color: rgb(235, 240, 255); }
