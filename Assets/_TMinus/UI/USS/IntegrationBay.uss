/* Integration Bay additions on top of VAB.uss */

.parts-bin-slot { bottom: 50px; }
.controls-hint { bottom: 16px; }

.bin-group { font-size: 12px; letter-spacing: 2px; color: rgb(255, 160, 90); -unity-font-style: bold; margin: 10px 0 4px 0; padding: 0; }
.bin-item.installed { border-left-color: rgb(60, 220, 110); background-color: rgba(60, 220, 110, 0.08); }
.bin-item.blocked { opacity: 0.55; }
.bin-row { flex-direction: row; justify-content: space-between; align-items: center; }
.remove-btn {
    height: 26px; padding: 0 10px; margin: 0;
    font-size: 13px; color: white;
    background-color: rgba(255, 80, 70, 0.6); border-width: 0; border-radius: 6px;
}

.right-col { position: absolute; right: 18px; top: 90px; bottom: 50px; width: 430px; }
.budgets-slot { flex-shrink: 0; }
.faults-panel {
    flex-grow: 1; flex-shrink: 1;
    margin-top: 10px;
    padding: 14px 16px;
    background-color: rgba(8, 14, 34, 0.92);
    border-radius: 14px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    border-left-width: 4px; border-left-color: rgb(255, 122, 26);
}
.faults-panel.clean { border-left-color: rgb(60, 220, 110); }
.fault-count { font-size: 15px; color: white; -unity-font-style: bold; padding: 0; }
.fault-list { flex-grow: 1; margin-top: 6px; }
.fault {
    padding: 8px 10px; margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border-left-width: 4px;
}
.fault.blocker { border-left-color: rgb(255, 80, 70); }
.fault.fault-sev { border-left-color: rgb(255, 150, 60); }
.fault.warning { border-left-color: rgb(255, 210, 80); }
.fault:hover { background-color: rgba(255, 255, 255, 0.1); }
.fault-tag { font-size: 11px; letter-spacing: 1px; -unity-font-style: bold; color: rgb(255, 170, 150); padding: 0; }
.fault-msg { font-size: 15px; color: white; white-space: normal; padding: 0; }
.fault-ok { font-size: 16px; color: rgb(150, 235, 170); white-space: normal; }

.tile-label {
    position: absolute;
    font-size: 14px; color: white; -unity-font-style: bold;
    background-color: rgba(8, 14, 34, 0.8);
    padding: 2px 7px; border-radius: 5px;
}
