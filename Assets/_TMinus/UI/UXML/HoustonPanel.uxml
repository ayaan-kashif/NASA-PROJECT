<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="houston-root" class="houston-root">
        <!-- Floating Action Button when panel is collapsed -->
        <ui:Button name="houston-toggle-fab" text="🎧" class="houston-toggle-fab" />

        <!-- Collapsible main panel -->
        <ui:VisualElement name="houston-panel" class="houston-panel hidden">
            <!-- Header -->
            <ui:VisualElement name="houston-header" class="houston-header">
                <ui:VisualElement class="houston-title-row">
                    <ui:Label text="🎧" style="font-size: 16px;" />
                    <ui:Label text="HOUSTON" class="houston-title" />
                </ui:VisualElement>
                <ui:Button name="houston-close-btn" text="✕" class="houston-close-btn" />
            </ui:VisualElement>

            <!-- Scrollable message stream -->
            <ui:ScrollView name="houston-messages-scroll" class="houston-messages-scroll">
                <ui:VisualElement name="houston-messages" />
            </ui:ScrollView>

            <!-- Typing indicator -->
            <ui:Label name="houston-typing" text="" class="houston-typing hidden" />

            <!-- Quick Action Buttons -->
            <ui:VisualElement name="houston-buttons-row" class="houston-buttons-row">
                <ui:Button name="btn-next" text="What's next? [N]" class="houston-btn" />
                <ui:Button name="btn-where" text="Where does this go?" class="houston-btn" />
                <ui:Button name="btn-scan" text="Scan build [Shift+S]" class="houston-btn" />
                <ui:Button name="btn-why" text="Why?" class="houston-btn" />
            </ui:VisualElement>

            <!-- Free question input -->
            <ui:VisualElement name="houston-input-row" class="houston-input-row">
                <ui:TextField name="houston-input" placeholder-text="Ask HOUSTON a question..." class="houston-input" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
